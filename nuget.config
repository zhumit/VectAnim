<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep every NuGet package and cache inside this project (.cache/nuget) so the global
  machine environment stays untouched.
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".cache/nuget/packages" />
    <add key="repositoryPath" value=".cache/nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
