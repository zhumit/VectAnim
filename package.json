{
  "name": "vectanim-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "VectAnim - data-driven vector graphics editor + WPF runtime rendering control",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "editor:check": "npm run typecheck && npm run test && npm run build",
    "dotnet:build": "dotnet build dotnet/VectAnim.sln -c Release",
    "dotnet:test": "dotnet run --project dotnet/VectAnim.Wpf.Tests/VectAnim.Wpf.Tests.csproj -c Release",
    "dotnet:probe": "dotnet run --project dotnet/VectAnim.RenderProbe/VectAnim.RenderProbe.csproj -c Release",
    "dotnet:pack": "dotnet pack dotnet/VectAnim.Wpf/VectAnim.Wpf.csproj -c Release -o artifacts/nuget",
    "all": "npm run editor:check && npm run dotnet:build && npm run dotnet:test && npm run dotnet:probe && npm run dotnet:pack",
    "smoke": "node tools/smoke-test.mjs",
    "demo:smoke": "dotnet run --project dotnet/VectAnim.Demo/VectAnim.Demo.csproj -- --smoke artifacts/screenshots/demo-window.png",
    "samples": "node tools/gen-samples.mjs"
  },
  "dependencies": {
    "fabric": "^7.4.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
